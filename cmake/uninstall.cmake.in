if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "No installation manifest; install this build first.")
endif()
file(STRINGS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" files)
foreach(path IN LISTS files)
  set(target "$ENV{DESTDIR}${path}")
  if(EXISTS "${target}" OR IS_SYMLINK "${target}")
    file(REMOVE "${target}")
  endif()
endforeach()
message(STATUS "Installed files removed. User configuration and dictionaries are preserved.")
